	quest.300EFF8BA559FE1D.quest_desc: [
		"Крючок автоматической стрельбы можно прикрепить к любому луку или арбалету на наковальне. Тогда оружие будет непрерывно стрелять, пока вы удерживаете кнопку использования."
		""
		"Попробуйте и решите, удобен ли вам такой способ стрельбы."
		""
		"Крючок можно снять на точиле."
	]
	quest.300EFF8BA559FE1D.quest_subtitle: "Стреляйте без остановки"
