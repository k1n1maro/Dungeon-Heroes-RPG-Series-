	quest.05EDF3599D5E4CBA.quest_desc: [
		"Герои,"
		""
		"если вам нужно больше силы, найдите это подземелье."
		""
		"Внутри много испытаний, за их выполнение вы будете постоянно вознаграждаться снаряжением."
		""
		"Лишь немногие исключительно удачливые могут найти эпическую добычу среди зловещих хранилищ."
	]
